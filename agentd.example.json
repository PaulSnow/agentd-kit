{
  "event_log": "~/.local/state/agentd-kit/events.jsonl",
  "poll_interval": "5m",
  "transcript_dir": "~/.claude/projects",
  "tracking": {
    "manifest": "~/tracking/manifest/repositories.json",
    "snapshot": "~/tracking/data/snapshot.json",
    "mail": "~/tracking/data/mail-findings.json",
    "priorities": "~/tracking/data/priorities.json"
  },
  "ui": {
    "address": "192.0.2.10:8770",
    "hosts": ["192.0.2.10:8770", "host-a.example.net:8770"],
    "whois": ["peer-whois", "--json", "{addr}"],
    "owner": "owner@example.com",
    "logs": ["coordinators.json"],
    "shadow": false
  },
  "confidential_patterns": ["(?i)embargoed", "(?i)customer:\\s*\\w+"],
  "timeouts": {
    "tmux": "10s",
    "forge": "2m",
    "escalate": "2m"
  },
  "poll": {
    "every": "15m",
    "github": false,
    "gitlab": false,
    "ci": false,
    "ci_every": "5m"
  },
  "usage": {
    "enabled": false,
    "every": "15m",
    "limit": 90
  },
  "jobs": {
    "triage": false,
    "model": "haiku",
    "timeout": "2m",
    "max_input": 16384,
    "batch": 20,
    "status": {"enabled": false, "every": "5m", "max_input": 20480}
  },
  "policies": {
    "restart": {
      "enabled": true,
      "max_restarts": 3,
      "max_crashes": 3,
      "window": "1h",
      "backoff_initial": "1m",
      "backoff_max": "30m",
      "command": ["bash", "-lic", "exec claude ${4:+--model \"$4\"} --session-id \"$1\" --mcp-config=\"$2\" \"$3\"", "agentd", "{session_id}", "{mcp}", "{prompt}", "{model}"],
      "width": 220,
      "height": 50
    },
    "nudge": {
      "enabled": true,
      "stall": "40m",
      "max": 3,
      "settle": "6m"
    },
    "trust_prompt": {
      "enabled": true,
      "pattern": "(?i)(do you )?trust (the files in )?this folder\\??",
      "keys": ["Enter"]
    },
    "dialog": {
      "patterns": ["Do you want to", "❯\\s*1\\.", "(?i)enter to confirm"],
      "decline_after": "0s"
    },
    "pane_commands": ["claude"],
    "context": {
      "enabled": true,
      "threshold": 120000,
      "grace": "5m"
    },
    "budget": {
      "session_tokens": 0,
      "run_tokens": 0
    },
    "escalate": {
      "command": ["~/bin/post-to-console", "{console}", "--kind", "decision", "{message}"],
      "default_console": "infra"
    }
  },
  "consoles": {
    "chat": {"title": "General chat", "sessions": ["chat-*"]}
  },
  "ops": {
    "console": "ops",
    "supervisors": {
      "live": {"config": "~/.config/agentd-kit/agentd.json", "tmux": "agentd-live"},
      "page": {"config": "~/.config/agentd-kit/page.json", "tmux": "agentd-page"}
    },
    "repo": "~/repos/agentd-kit"
  },
  "items": {"ack_within": "10m", "escalate_after": "2h"},
  "repositories": {
    "widgets": {
      "forge": "gitlab",
      "host": "gitlab.example.com",
      "transport": "ssh",
      "project": "example-org/widgets",
      "clone_on": ["host-a", "host-b"],
      "console": "widgets",
      "assignee": "123456",
      "policy": {
        "delivery": {"allow": ["push", "open"]},
        "gate": {"argv": ["./bin/check"], "timeout": "20m"},
        "merge": {
          "enabled": true,
          "method": "fast-forward",
          "targets": ["main"],
          "authors": ["widget-bot"],
          "exclude": {"labels": ["do-not-merge"]},
          "require": ["gate", "ci"]
        },
        "review": {"rounds": {"max": 3}},
        "scope": {"reserved": {"labels": ["owner-only"]}},
        "sessions": {"accounts": ["work"], "max": 2, "budget": {"session_tokens": 2000000}, "fallback": ["work", "spare"]}
      },
      "deploy": {
        "clone": "~/repos/gitlab.example.com/example-org/widgets",
        "tags": "^v[0-9]",
        "gate": {"argv": ["scripts/resilience/parity.sh", "{tag}"], "timeout": "45m"},
        "targets": {
          "browser": {
            "host": "service-host", "via": "ssh", "node": "host-b",
            "check": {"url": "https://browser.example.com/api/version", "json_path": "version"},
            "steps": [
              {"name": "install", "run": ["/opt/widgets/install.sh", "{tag}"], "check": ["/opt/widgets/selftest.sh"], "rollback": ["/opt/widgets/install.sh", "previous"]}
            ]
          },
          "signers": {"kind": "fleet", "heartbeats": "https://browser.example.com/api/heartbeats", "threshold": 5, "escalate_after": "24h"}
        }
      }
    },
    "gadgets": {
      "forge": "github",
      "host": "github.com",
      "transport": "https",
      "project": "example-org/gadgets",
      "console": "gadgets",
      "policy": {
        "delivery": {"allow": ["push", "open"]},
        "gate": {"argv": ["make", "test"], "paths": ["Makefile"]}
      }
    }
  },
  "hub": {"address": "192.0.2.10:7450", "silent_after": "10m", "retry_after": "30m"},
  "hosts": {
    "host-a": {"token_file": "~/.config/agentd-kit/hosts/host-a.token"},
    "host-b": {"token_file": "~/.config/agentd-kit/hosts/host-b.token"}
  },
  "node": {
    "name": "host-a",
    "hub": "http://192.0.2.10:7450",
    "token_file": "~/.config/agentd-kit/node.token",
    "repos_root": "~/repos",
    "every": "1m",
    "clone_timeout": "30m",
    "open_state": [".kickoff"],
    "sessions_root": "~/sessions",
    "launch": ["claude", "--model", "{model}", "Read {brief} and follow it; keep {status} current."],
    "accounts": {"work": {"config_dir": "~/.claude-work"}}
  },
  "accounts": {
    "work": {
      "config_dir": "~/.claude-work"
    },
    "spare": {
      "config_dir": "~/.claude-spare",
      "token_file": "~/.config/agentd-kit/spare.token",
      "usage": "headers"
    }
  },
  "sessions": {
    "w17": {
      "workdir": "~/work-17",
      "cwd": "~/repos/widgets-wt/17",
      "account": "work",
      "repository": "widgets",
      "issue": 17,
      "deliver": [
        {
          "repository": "widgets",
          "worktree": "~/repos/widgets-wt/17",
          "target": "main",
          "mr_file": "~/work-17/mr-description.md"
        }
      ]
    },
    "g42": {
      "workdir": "~/work-42",
      "cwd": "~/repos/gadgets",
      "repository": "gadgets",
      "hold": "Delivery waits for the owner's design review (2026-10-22)"
    }
  }
}
